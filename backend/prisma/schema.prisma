datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  name         String
  role         String        // "ADMIN", "ASSET_MANAGER", "DEPARTMENT_HEAD", "EMPLOYEE"
  password     String        @default("")
  status       String        @default("ACTIVE") // "ACTIVE", "INACTIVE"
  departmentId String?
  department   Department?   @relation("DeptUsers", fields: [departmentId], references: [id])
  allocations     Allocation[]
  allocatedBy     Allocation[]  @relation("AllocatedByUser")
  transfersReq    Transfer[]    @relation("RequestedBy")
  transfersApp    Transfer[]    @relation("ApprovedBy")
  transfersFrom   Transfer[]    @relation("TransferFromUser")
  transfersTo     Transfer[]    @relation("TransferToUser")
  bookings     Booking[]
  activities   ActivityLog[]
  notifications Notification[]
  deptHeadOf   Department[]  @relation("DeptHead")
  requestedMaintenance Maintenance[] @relation("RequestedMaintenance")
  createdAt    DateTime      @default(now())
}

model Department {
  id                 String        @id @default(uuid())
  name               String        @unique
  departmentCode     String        @unique
  parentDepartmentId String?
  parentDepartment   Department?   @relation("SubDepartments", fields: [parentDepartmentId], references: [id])
  subDepartments     Department[]  @relation("SubDepartments")
  headEmployeeId     String?
  headEmployee       User?         @relation("DeptHead", fields: [headEmployeeId], references: [id])
  status             String        @default("ACTIVE") // "ACTIVE", "INACTIVE"
  users              User[]        @relation("DeptUsers")
  assets             Asset[]
  transfersFrom      Transfer[]    @relation("FromDept")
  transfersTo        Transfer[]    @relation("ToDept")
  auditCycles        AuditCycle[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model AssetCategory {
  id           String    @id @default(uuid())
  name         String    @unique
  description  String?
  customFields String?   // Comma-separated list of custom field names
  status       String    @default("ACTIVE") // "ACTIVE", "INACTIVE"
  assets       Asset[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Asset {
  id                 String        @id @default(uuid())
  assetTag           String        @unique // e.g., AF-0001
  name               String
  categoryId         String?
  category           AssetCategory? @relation(fields: [categoryId], references: [id])
  status             String        // "AVAILABLE", "ALLOCATED", "UNDER_MAINTENANCE", "TRANSFERRED"
  serialNumber       String?
  model              String?
  location           String?
  value              Float         @default(0.0)
  expectedReturnDate DateTime?     // Used for tracking upcoming/overdue returns
  departmentId       String?
  department         Department?   @relation(fields: [departmentId], references: [id])
  allocations        Allocation[]
  transfers          Transfer[]
  bookings           Booking[]
  maintenanceRecords Maintenance[]
  documents          AssetDocument[]
  condition          String?       // "NEW", "GOOD", "FAIR", "POOR"
  purchaseDate       DateTime?
  purchaseCost       Float         @default(0.0)
  bookable           Boolean       @default(false)
  imageUrl           String?
  qrCode             String?
  auditRecords       AuditRecord[]
  discrepancyReports DiscrepancyReport[]
  createdAt          DateTime      @default(now())
}

model AssetDocument {
  id        String   @id @default(uuid())
  name      String
  url       String
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Allocation {
  id                    String    @id @default(uuid())
  assetId               String
  asset                 Asset     @relation(fields: [assetId], references: [id])
  userId                String
  user                  User      @relation(fields: [userId], references: [id])
  allocatedAt           DateTime  @default(now())
  returnedAt            DateTime?
  expectedReturnDate    DateTime?
  conditionAtAllocation String?   // "NEW", "GOOD", "FAIR", "POOR"
  conditionAtReturn     String?   // "NEW", "GOOD", "FAIR", "POOR"
  status                String    @default("ACTIVE") // "ACTIVE", "CLOSED"
  notes                 String?
  allocatedById         String?
  allocatedBy           User?     @relation("AllocatedByUser", fields: [allocatedById], references: [id])
}

model Transfer {
  id               String      @id @default(uuid())
  assetId          String
  asset            Asset       @relation(fields: [assetId], references: [id])
  fromDepartmentId String
  fromDepartment   Department  @relation("FromDept", fields: [fromDepartmentId], references: [id])
  toDepartmentId   String
  toDepartment     Department  @relation("ToDept", fields: [toDepartmentId], references: [id])
  status           String      // "PENDING", "APPROVED", "REJECTED"
  requestedById    String
  requestedBy      User        @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedById     String?
  approvedBy       User?       @relation("ApprovedBy", fields: [approvedById], references: [id])
  fromUserId       String?
  fromUser         User?       @relation("TransferFromUser", fields: [fromUserId], references: [id])
  toUserId         String?
  toUser           User?       @relation("TransferToUser", fields: [toUserId], references: [id])
  reason           String?
  requestedAt      DateTime    @default(now())
  approvedAt       DateTime?
}

model Booking {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  startTime DateTime
  endTime   DateTime
  status    String   // "ACTIVE", "COMPLETED", "CANCELLED"
  purpose   String?
  createdAt DateTime @default(now())
}

model Maintenance {
  id                 String    @id @default(uuid())
  assetId            String
  asset              Asset     @relation(fields: [assetId], references: [id])
  description        String    // Issue description
  priority           String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH"
  status             String    @default("PENDING") // "PENDING", "APPROVED", "TECHNICIAN_ASSIGNED", "IN_PROGRESS", "RESOLVED"
  assignedTechnician String?   // Technician name or ID
  requestedById      String?
  requestedBy        User?     @relation("RequestedMaintenance", fields: [requestedById], references: [id])
  cost               Float     @default(0.0)
  scheduledFor       DateTime  @default(now())
  approvedAt         DateTime?
  startedAt          DateTime?
  resolvedAt         DateTime?
  resolutionNotes    String?
  createdAt          DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  type      String   // "OVERDUE_RETURN", "MAINTENANCE_DUE", "TRANSFER_REQUEST", "GENERAL"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(uuid())
  type      String   // "ASSET_CREATED", "ASSET_ALLOCATED", "MAINTENANCE_CREATED", "TRANSFER_REQUESTED", etc.
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

model AuditCycle {
  id                String              @id @default(uuid())
  title             String
  departmentId      String
  department        Department          @relation(fields: [departmentId], references: [id])
  location          String?
  startDate         DateTime
  endDate           DateTime
  assignedAuditors  String              // Comma-separated auditor emails
  status            String              @default("ACTIVE") // "ACTIVE", "CLOSED"
  createdAt         DateTime            @default(now())
  closedAt          DateTime?
  records           AuditRecord[]
  discrepancies     DiscrepancyReport[]
}

model AuditRecord {
  id                 String     @id @default(uuid())
  auditCycleId       String
  auditCycle         AuditCycle @relation(fields: [auditCycleId], references: [id])
  assetId            String
  asset              Asset      @relation(fields: [assetId], references: [id])
  expectedLocation   String
  actualLocation     String?
  verificationStatus String     @default("PENDING") // "PENDING", "VERIFIED", "MISSING", "DAMAGED"
  remarks            String?
  verifiedBy         String?
  verifiedAt         DateTime?
}

model DiscrepancyReport {
  id               String     @id @default(uuid())
  auditCycleId     String
  auditCycle       AuditCycle @relation(fields: [auditCycleId], references: [id])
  assetId          String
  asset              Asset      @relation(fields: [assetId], references: [id])
  issueType        String     // "MISSING", "DAMAGED"
  severity         String     // "HIGH", "MEDIUM"
  resolutionStatus String     @default("PENDING") // "PENDING", "RESOLVED"
  generatedAt      DateTime   @default(now())
}
